# Домен, на который выпускается сертификат Let's Encrypt.
# A-запись должна указывать на IP этого VPS.
SITE_DOMAIN=wheel.rprokhorov.ru

# Почта для уведомлений Let's Encrypt об истечении сертификата
ACME_EMAIL=i@rprokhorov.ru

# Тег образа из ghcr.io: latest или конкретный SHA/версия
TAG=latest

# --- Аналитика ---

# Постоянная соль для org_id (хеш IP → «одна организация»).
# ВАЖНО: менять нельзя. После смены старые и новые события
# перестанут группироваться вместе, а восстановить связь
# получится только пока в базе ещё лежат сырые IP.
# Сгенерировать: openssl rand -hex 32
ORG_SALT=смените_на_случайную_строку

# Доступ к /api/stats
DASH_USER=admin
DASH_PASS=смените_на_свой_пароль

# Через сколько дней обнулять сырые IP в событиях.
# 0 — хранить бессрочно (org_id считается при записи,
# поэтому удаление IP аналитику не ломает).
IP_RETENTION_DAYS=0
