{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode gzip zstd

	# Аналитика: свой домен, поэтому блокировщики рекламы запросы не режут.
	# handle идёт до общего маршрута, иначе /api ушёл бы на статику.
	handle /api/* {
		reverse_proxy collector:8081
	}

	handle {
		reverse_proxy site:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
